mono_crash.*.json
*.crash

# Large gsplat source data (baked GaussianAssets are already ignored above)
*.spz
*.spz.meta
*.sog
*.sog.meta

# Editor screenshot artifacts
Screenshots/
/projects/**/Assets/Screenshots/
/projects/**/Assets/Screenshots.meta

# Generated LOD .ply (big; regenerate with tools/gsplat_lod)
/tools/gsplat_lod/out/
*.ply

# Python cache
__pycache__/
*.pyc

# Spike throwaway scene (references gitignored GaussianAssets)
/projects/**/Assets/SpikeLOD.unity*

# Phase 1 throwaway scene (references gitignored GaussianAssets)
/projects/**/Assets/Phase1LOD.unity*

# Phase 2 throwaway scene (references gitignored GaussianAssets)
/projects/**/Assets/Phase2LOD.unity*

# Addressables config (group entries reference gitignored/regenerable baked assets)
/projects/**/Assets/AddressableAssetsData/
/projects/**/Assets/AddressableAssetsData.meta

# Phase 2 async throwaway scene
/projects/**/Assets/Phase2Async.unity*
